# =============================================================
#  Шаблон .env — скопируй в .env и заполни своими значениями
#  Сгенерировать SECRET_KEY:
#    python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# =============================================================

# Django core
# Оборачивай в одинарные кавычки — ключ может содержать $, # и другие спецсимволы
SECRET_KEY='замени-на-случайную-строку'
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# CORS: разрешённые origins для фронтенда (через запятую)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Throttling (брутфорс логина)
LOGIN_THROTTLE_RATE=5/min

# Число доверенных прокси перед Django, которые ДОПИСЫВАЮТ адрес в X-Forwarded-For.
# Не задано — берётся первый адрес XFF (клиент может его подделать и обойти throttle логина).
# Перед включением посчитай реальные хопы: залогируй X-Forwarded-For на проде и проверь,
# сколько адресов добавляют твои прокси (прокси, который заменяет заголовок, не считается).
# Неверное значение опасно: меньше реального — все пользователи получат IP прокси и попадут
# в одну корзину throttle логина (5/min на всех); больше реального — IP снова подделывается.
# NUM_PROXIES=1

# Логирование
DJANGO_LOG_LEVEL=WARNING

# Sentry (оставь пустым чтобы отключить)
SENTRY_DSN=

# Redis (для Django Channels / прокторинг)
REDIS_URL=redis://127.0.0.1:6379
